# Contratto dei segreti/config del backend (AR-11).
# Copia in `.env` per lo sviluppo locale. MAI committare `.env`.
# In staging/prod i valori vivono nel secret manager dell'ambiente.

# Ambiente: dev | staging | prod
HOSTPILOT_ENV=dev

# PostgreSQL 18 (driver psycopg3)
HOSTPILOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hostpilot

# Intervallo di polling del worker outbox/job, in secondi
HOSTPILOT_WORKER_POLL_SECONDS=1.0

# Solo test: URL del database dei test di integrazione
# HOSTPILOT_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/hostpilot_test

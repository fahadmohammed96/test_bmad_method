# Contratto dei segreti/config del backend (AR-11).
# Copia in `.env` per lo sviluppo locale. MAI committare `.env`.
# In staging/prod i valori vivono nel secret manager dell'ambiente.

# Ambiente: dev | staging | prod
HOSTPILOT_ENV=dev

# PostgreSQL 18 (driver psycopg3)
HOSTPILOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hostpilot

# Intervallo di polling del worker outbox/job, in secondi
HOSTPILOT_WORKER_POLL_SECONDS=1.0

# Sessione server-side (AD-15). TLS è richiesto su tutti gli ambienti:
# il flag Secure resta true; l'override a false è ammesso SOLO in dev
# locale su http (browser senza TLS).
HOSTPILOT_SESSION_COOKIE_SECURE=true
HOSTPILOT_SESSION_TTL_DAYS=30

# Origin del frontend ammessa dal CORS (cookie con credentials)
HOSTPILOT_FRONTEND_ORIGIN=http://localhost:3000

# Token degli endpoint interni di configurazione normativa e dei
# parametri fiscali del Regime (AD-9, AD-12).
# Vive nel secret manager dell'ambiente; se vuoto gli endpoint /interno
# restano chiusi. Aggiornare aliquote/tracciati è un'operazione DATI.
HOSTPILOT_ADMIN_TOKEN=

# Solo test: URL del database dei test di integrazione
# HOSTPILOT_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/hostpilot_test

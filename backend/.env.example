# Contratto dei segreti/config del backend (AR-11).
# Copia in `.env` per lo sviluppo locale. MAI committare `.env`.
# In staging/prod i valori vivono nel secret manager dell'ambiente.

# Ambiente: dev | staging | prod
HOSTPILOT_ENV=dev

# PostgreSQL 18 (driver psycopg3)
HOSTPILOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hostpilot

# Intervallo di polling del worker outbox/job, in secondi
HOSTPILOT_WORKER_POLL_SECONDS=1.0

# Freno ai tentativi di login (finestra temporale, mai lockout permanente)
HOSTPILOT_LOGIN_MAX_TENTATIVI_ACCOUNT=5
HOSTPILOT_LOGIN_MAX_TENTATIVI_ORIGINE=20
HOSTPILOT_LOGIN_FINESTRA_MINUTI=15

# Ogni quanto gira il purge delle sessioni scadute (job durevole)
HOSTPILOT_PURGE_SESSIONI_INTERVALLO_MINUTI=60

# Sessione server-side (AD-15). TLS è richiesto su tutti gli ambienti:
# il flag Secure resta true; l'override a false è ammesso SOLO in dev
# locale su http (browser senza TLS).
HOSTPILOT_SESSION_COOKIE_SECURE=true
HOSTPILOT_SESSION_TTL_DAYS=30

# Origin del frontend ammessa dal CORS (cookie con credentials)
HOSTPILOT_FRONTEND_ORIGIN=http://localhost:3000

# Token degli endpoint interni di configurazione normativa e dei
# parametri fiscali del Regime (AD-9, AD-12).
# Vive nel secret manager dell'ambiente; se vuoto gli endpoint /interno
# restano chiusi. Aggiornare aliquote/tracciati è un'operazione DATI.
HOSTPILOT_ADMIN_TOKEN=

# Politica di uscita di rete verso i Feed iCal (NFR-17). L'URL del Feed è
# input non fidato che il worker dereferenzia: timeout e cap di dimensione
# sono configurazione, non costanti di codice (NFR-4).
HOSTPILOT_FEED_TIMEOUT_CONNESSIONE_SECONDI=5.0
HOSTPILOT_FEED_TIMEOUT_LETTURA_SECONDI=10.0
HOSTPILOT_FEED_DIMENSIONE_MASSIMA_BYTE=5242880
HOSTPILOT_FEED_MAX_REDIRECT=3
# Tetto sull'INTERO fetch, redirect compresi. I timeout sopra sono
# per-operazione: un portale che sgocciola un byte appena dentro il
# timeout di lettura non ne farebbe scattare nessuno, e il worker è un
# ciclo sequenziale — la connessione appesa fermerebbe i job di tutti.
HOSTPILOT_FEED_DEADLINE_TOTALE_SECONDI=30.0
# Reti vietate dalla denylist (loopback, private, link-local, metadati
# d'istanza) da ammettere comunque, in CIDR separati da virgola.
# LASCIARE VUOTO in ogni ambiente reale: serve ai test e a un'eventuale
# installazione self-hosted con il portale in rete locale.
HOSTPILOT_FEED_RETI_CONSENTITE=

# Solo test: URL del database dei test di integrazione
# HOSTPILOT_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/hostpilot_test

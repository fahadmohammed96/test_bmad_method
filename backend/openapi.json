              }
            ],
            "title": "Cin"
          },
          "comune": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Comune",
            "type": "string"
          },
          "nome": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Nome",
            "type": "string"
          },
          "regione": {

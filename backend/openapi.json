{
  "components": {
    "schemas": {
      "CambioPasswordInput": {
        "properties": {
          "password_attuale": {
            "maxLength": 128,
            "title": "Password Attuale",
            "type": "string"
          },
          "password_nuova": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password Nuova",
            "type": "string"
          }
        },
        "required": [
          "password_attuale",
          "password_nuova"
        ],
        "title": "CambioPasswordInput",
        "type": "object"
      },
      "CanaleNotifica": {
        "description": "Canali di notifica Host dell'MVP (envelope operativo: in-app + email).",
        "enum": [
          "in_app",
          "email"
        ],
        "title": "CanaleNotifica",
        "type": "string"
      },
      "CredenzialiInput": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "CredenzialiInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HostOutput": {
        "properties": {
          "canale_notifica_preferito": {
            "$ref": "#/components/schemas/CanaleNotifica"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "canale_notifica_preferito"
        ],
        "title": "HostOutput",
        "type": "object"
      },
